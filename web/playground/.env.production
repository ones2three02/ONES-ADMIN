VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 飞书登录配置，未配置时入口保留为配置提示，不发起真实授权

# 企业 SSO 登录配置，未配置时登录页不展示入口
VITE_GLOB_AUTH_SSO_NAME=
VITE_GLOB_AUTH_SSO_URL=

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=false
